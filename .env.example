# ==============================================================================
# TrueCost Autopilot — Environment Configuration Template (.env.example)
# NEVER commit real secrets to source control. Copy this file to `.env` locally.
# ==============================================================================

# --- 1. LLM Provider Configuration (DeepSeek / OpenAI-Compatible Adapter) ---
DEEPSEEK_API_KEY=your_deepseek_api_key_here
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-chat

# --- 2. Persistent Financial Database & Rate Limiting ---
# Default SQLite WAL-mode ledger location: backend/data/truecost_bank.db
# TRUECOST_DB_PATH=backend/data/truecost_bank.db
TRUECOST_RATE_LIMIT_PER_MIN=120

# --- 3. External Indonesian Payment Gateways (Xendit & Midtrans) ---
# Set PAYMENT_LIVE_HTTP=true to send live HTTP requests to Xendit/Midtrans Sandbox APIs.
# When false (default), deterministic sandbox references, QRIS payloads, and VA numbers are used.
PAYMENT_LIVE_HTTP=false

# Xendit (QRIS, Virtual Accounts, v2 Invoices)
# Webhook Callback Endpoint: POST /api/webhooks/xendit
XENDIT_SECRET_KEY=xnd_development_your_secret_key_here
XENDIT_WEBHOOK_VERIFICATION_TOKEN=xnd_sandbox_webhook_secret_2026

# Midtrans (Snap Checkout, BCA/Mandiri/BNI Virtual Accounts, GoPay/QRIS)
# Webhook Notification Endpoint: POST /api/webhooks/midtrans
# Signature Verification Formula: SHA512(order_id + status_code + gross_amount + MIDTRANS_SERVER_KEY)
MIDTRANS_SERVER_KEY=SB-Mid-server-sandbox_secret_2026
MIDTRANS_CLIENT_KEY=SB-Mid-client-sandbox_key_2026
